{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelfNote",
  "version": "0.1.0",
  "identifier": "ru.nskarl.selfnote.desktop",
  "build": {
    "frontendDist": "../../app/apps/web/dist-desktop",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Заметки и задачи",
    "copyright": "© 2026 Вячеслав Кожевятов",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "../dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 185
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 185
        }
      }
    }
  }
}
