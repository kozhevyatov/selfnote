{
  "expo": {
    "name": "SelfNote",
    "slug": "selfnote",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "selfnote",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ECEBE7",
    "ios": {
      "bundleIdentifier": "ru.nskarl.selfnote",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "SelfNote подключается к вашему серверу заметок в домашней сети."
      }
    },
    "android": {
      "package": "ru.nskarl.selfnote",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
