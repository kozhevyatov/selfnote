{
  "expo": {
    "name": "SelfNote",
    "slug": "selfnote",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "selfnote",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#ECEBE7",
    "ios": {
      "bundleIdentifier": "ru.nskarl.selfnote",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "SelfNote подключается к вашему серверу заметок в домашней сети."
      }
    },
    "android": {
      "package": "ru.nskarl.selfnote",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3451D1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#ECEBE7",
          "dark": {
            "backgroundColor": "#141416"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SelfNote добавляет выбранные фото в ваши заметки.",
          "cameraPermission": "SelfNote снимает фото, чтобы добавить его в заметку.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4e12ea4d-5c1c-4225-837d-c0301b355c16"
      }
    },
    "owner": "nskarl"
  }
}
