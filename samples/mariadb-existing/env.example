# Версия образа: latest, номер релиза (например 0.2.0) или sha-коммита.
# SELFNOTE_TAG=latest
# Внешний порт на хосте.
PORT=1339
# В Docker используется /data; локально — data/ рядом с app/.
# Переопределение ниже применяется только при локальном запуске.
# DATA_DIR=/absolute/path/to/selfnote/data
# На домене с HTTPS обязательно true; на localhost оставьте false.
COOKIE_SECURE=false
# Полный внешний адрес. Без завершающего /.
# APP_ORIGIN=https://notes.example.ru
# true только за доверенным reverse proxy в закрытой Docker-сети.
TRUST_PROXY=false
# Необязательно: по умолчанию ключ генерируется в data/jwt.key.
# JWT_SECRET=
# Необязательно: от какого пользователя NAS запускать сервис (по умолчанию UID/GID 1000).
# PUID=1026
# PGID=100

# Имя существующей Docker-сети с MariaDB (docker network ls).
DB_NETWORK=db

# Часовой пояс сервиса: время в журнале и расписание ночных бэкапов.
TZ=Europe/Moscow
# Автоматические резервные копии: раз в сутки после BACKUP_HOUR (по TZ).
BACKUP_ENABLED=true
BACKUP_HOUR=4
# Куда класть копии внутри контейнера. Чтобы хранить их на другой общей папке NAS,
# добавьте в compose том, например - /volume1/backup/selfnote:/backups, и укажите /backups.
# BACKUP_DIR=/data/backups
