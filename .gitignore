# Зависимости и сборка
node_modules/
dist/
dist-desktop/
coverage/
*.tsbuildinfo

# Данные сервиса и секреты — никогда не коммитим
/data/*
!/data/.gitkeep
.env
.env.*
!env.example

# Личные экспорты для импорта (Note Station и т. п.)
/import-samples/

# Системное и редакторы
.DS_Store
*.log
.idea/
.vscode/

# Данные при запуске примеров прямо из samples/
/samples/*/data/
/samples/*/mariadb/
/mariadb/

# Макеты дизайна — только локально (референс для разработки)
/design/

# Промежуточная сборка редактора для мобильного приложения
.mobile-editor/
